// To compute area and perimeter with input length and breadth 

#include <stdio.h>

int main()
{
	float l, b, area, perimeter;
	
	printf("Enter length: ");
	scanf("%f", &l);
	
	printf("Enter breadth: ");
	scanf("%f", &b);
	
	area = l * b;
	perimeter = 2 * (l * b);
	
	printf("The area is: %.2f\n Perimeter is: %.2f", area, perimeter);
	
	return 0;
}
