// to input length, breadth, height and compute volume of cuboid.

#include <stdio.h>

int main()
{
	int l, b, h, vol;
	
	printf("Enter length: ");
	scanf("%d", &l);
	
	printf("Enter breadth: ");
	scanf("%d", &b);
	
	printf("Enter heignt");
	scanf("%d", &h);
	
	vol = l * b * h;
	
	printf("volume is: %d", vol);
	
	return 0;
}
